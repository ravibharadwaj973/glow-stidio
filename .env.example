# ---------- Aster: a worked example of a SALON'S OWN website ----------
#
# Nothing of Parlon's appears on it. The slug is the one line that matters: it
# is how the booking API knows whose diary this site writes into, so pointing
# this at a different salon is a one-variable change.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In production:  https://api.jharavi.in/api/v1

NEXT_PUBLIC_SALON_SLUG=parlon
