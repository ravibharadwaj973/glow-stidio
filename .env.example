# ---------- Aster: a worked example of a SALON'S OWN website ----------
#
# Nothing of Parlon's appears on it. The slug is the one line that matters: it
# is how the booking API knows whose diary this site writes into, so pointing
# this at a different salon is a one-variable change.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In production:  https://api.jharavi.in/api/v1

NEXT_PUBLIC_SALON_SLUG=parlon

# ---------- Photographs (Cloudinary) ----------
#
# The cloud name only. It appears in every delivery URL, so it is public by
# design and belongs in a NEXT_PUBLIC_ variable.
#
# There is deliberately NO API key or secret here. The site reads photographs
# through Cloudinary's unsigned, read-only tag-list endpoint, so the worst a
# leak of this file could do is tell somebody the cloud name they can already
# read in any <img src>. An Admin API secret, by contrast, can delete every
# image in the account — see src/lib/cloudinary.ts.
#
# Leave this unset and the gallery falls back to the local files named in
# src/lib/gallery.ts, which is how the site works out of the box.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
API_Secret=lFl92Ik6TD5U2cL8twZJK2abcxo
CLOUD_NAME=dorcnajnz
API_Key=834445435344757
